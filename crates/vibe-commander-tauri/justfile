set quiet

default:
    @just --list --unsorted

alias b := build
alias c := check
alias f := fmt
alias r := run
alias t := test

# --- dev ---

[group('dev')]
run *ARGS:
    RUST_LOG=vibe_commander=trace cargo run -- {{ ARGS }}

[group('dev')]
build:
    cargo build --release

[group('dev')]
watch:
    bacon

[group('dev')]
clean:
    cargo clean

# --- check ---

[group('check')]
check: fmt-check clippy test

[group('check')]
fmt:
    cargo fmt

[group('check')]
fmt-check:
    cargo fmt --all -- --check

[group('check')]
clippy:
    cargo clippy --all-targets -- -D warnings

[group('check')]
test *ARGS:
    cargo nextest run {{ ARGS }}

# --- fix ---

[group('fix')]
fix:
    cargo clippy --all-targets --all-features --fix --allow-dirty --allow-staged

# --- tools ---

[group('tools')]
deny:
    cargo deny check

[group('tools')]
install-tooling:
    mise install
